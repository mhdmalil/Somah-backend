# SOMAHLAND Backend — copy to .env and fill values
# Never commit real secrets.

PORT=3001
NODE_ENV=development

# Supabase Postgres (service role — server only)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# JWT secrets (long random strings — REQUIRED)
JWT_CUSTOMER_SECRET=
JWT_ADMIN_SECRET=
JWT_EXPIRES_IN=7d

# CORS — comma-separated origins
FRONTEND_URL=http://localhost:3002

# Delivery fee AED
DELIVERY_FEE=25

# Bootstrap first admin on startup if no admins exist
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=SOMAHLAND Admin

# Telegram — use a NEW SOMAHLAND bot token (do not reuse old bot)
TELEGRAM_BOT_TOKEN=
# Optional: set explicitly; otherwise discovered when bot is messaged in a group
TELEGRAM_CHAT_ID=
