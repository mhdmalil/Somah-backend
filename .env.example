# SOMAHLAND Backend — copy to .env and fill values
# Never commit real secrets.

PORT=3001
NODE_ENV=development

# Supabase Postgres (service role — server only)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# JWT secrets (long random strings — REQUIRED)
JWT_CUSTOMER_SECRET=
JWT_ADMIN_SECRET=
JWT_EXPIRES_IN=7d

# CORS — comma-separated origins
FRONTEND_URL=http://localhost:3002

# Delivery fee AED
DELIVERY_FEE=25

# Bootstrap first admin on startup if no admins exist
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=SOMAHLAND Admin

# Vehicle identity provider (optional until approved — server only, never frontend)
VEHICLE_API_KEY=
VEHICLE_API_URL=

# Fitment data provider (separate from VIN — optional until approved)
FITMENT_API_KEY=
FITMENT_API_URL=
